# Melodify Server Environment Variables
# Copy this file to .env and fill in the values

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/melodify_db
JWT_SECRET=your-secret-key-here
ADMIN_EMAIL=admin@melodify.com
ADMIN_PASSWORD=your-admin-password-here
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# AI Recommendation capabilities (disabled during incremental development)
# Only exact lowercase true or 1 enables a flag; all other values disable it.
RECOMMENDATION_CATALOG_SYNC_ENABLED=false
RECOMMENDATION_LISTENING_EVENTS_ENABLED=false
RECOMMENDATION_TRENDING_ENABLED=false
RECOMMENDATION_AI_ENABLED=false
RECOMMENDATION_ADMIN_METRICS_ENABLED=false

# Server-only YouTube Data API key (never expose to the client)
YOUTUBE_API_KEY=

# For Vercel deployment:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/melodify_db
# JWT_SECRET=<strong-random-string>
# CORS_ORIGIN=https://your-app.vercel.app
# NODE_ENV=production
